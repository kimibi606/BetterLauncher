{
  "name": "betterlauncher",
  "version": "0.4.27",
  "description": "Single-modpack Minecraft launcher with independent modpack distribution.",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check src/renderer.js && node --check src/skin-model.js && node --check src/skin-model-fallback.js && node --check lib/window-geometry.js && node --check lib/account-skin.js && node --check lib/neoforge-runtime.js && node --check lib/zip-entry-names.js && node --check lib/modpack-path-renames.js && node --check lib/resourcepack-settings.js && node --check lib/microsoft-login-errors.js && node --check scripts/import-modpack-zip.js && node --check scripts/build-launcher.js && node --check vendor/request/index.js && node --check lib/secure-fetch.js && node --check lib/log-security.js && node --check vendor/request/network-security.js && node --check lib/projects.js && node --check lib/distribution-download.js && node --check scripts/publish-modpack-distribution.js && node --check scripts/build-modpack-distribution.js && node scripts/validate-release.js && node scripts/sync-skin-renderer.js --check",
    "dist": "node scripts/build-launcher.js",
    "dist:win": "node scripts/build-launcher.js",
    "dist:dir": "node scripts/build-launcher.js --dir",
    "release:github": "npm run check && node scripts/build-launcher.js",
    "modpack:publish": "node scripts/publish-modpack-distribution.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:ui": "electron tests/renderer-flow.cjs",
    "test:installer": "node scripts/test-installer-migration.js",
    "modpack:build": "node scripts/build-modpack-distribution.js",
    "modpack:deploy": "node scripts/deploy-modpacks.js",
    "dist:private": "node scripts/build-launcher.js",
    "vendor:skin": "node scripts/sync-skin-renderer.js",
    "test:window": "electron tests/window-geometry.cjs"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "0.6.1",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2",
    "prismarine-nbt": "2.8.0",
    "request": "file:vendor/request",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "electron": "^43.8.7",
    "electron-builder": "^26.18.0",
    "skinview3d": "3.4.2",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "minecraft-launcher-core": {
      "request": "$request",
      "uuid": "^11.1.1",
      "adm-zip": "0.6.1"
    },
    "@electron/get": "5.0.0",
    "minimatch": "11.0.4",
    "node-gyp": {
      "undici": "6.29.1"
    }
  },
  "build": {
    "appId": "com.betterlauncher.launcher",
    "productName": "BetterLauncher",
    "asar": true,
    "allowMissingDependencies": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "vendor/request/**/*",
      "package.json",
      "lib/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/assets/app-icon.ico",
      "signExecutable": false,
      "artifactName": "BetterLauncher-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "src/assets/app-icon.ico",
      "uninstallerIcon": "src/assets/app-icon.ico",
      "installerHeaderIcon": "src/assets/app-icon.ico",
      "guid": "0e192e02-a904-5be6-bca2-04cae62ae05b"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kimibi606",
        "repo": "BetterLauncher",
        "releaseType": "release"
      }
    ]
  }
}
